    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pdf-parse": "^1.1.5",
    "autoprefixer": "^10.4.21",
    "lightningcss-win32-x64-msvc": "^1.33.0",
    "rollup": "npm:@rollup/wasm-node@^4.64.5",
