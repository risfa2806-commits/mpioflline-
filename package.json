    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "iceberg-js": "^1.0.0",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "magic-string": "^0.30.17",
    "mammoth": "^1.12.3",
    "motion": "^12.23.24",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-redux": "^9.3.0",
    "recharts": "^3.10.1",
    "redux": "^5.0.1",
    "reselect": "^5.3.0",
    "tsx": "^4.21.0",
    "xlsx": "^0.18.5"
